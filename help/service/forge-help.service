# Forge Help Bot — systemd unit (Linux/VPS)
#
#   1. sudo cp forge-help.service /etc/systemd/system/
#   2. sudo systemctl daemon-reload
#   3. sudo systemctl enable --now forge-help
#   4. journalctl -u forge-help -f
#
# Adjust User/WorkingDirectory/ExecStart to your install.

[Unit]
Description=Forge Help Bot (Telegram AI help assistant)
Documentation=file:///opt/forge/help/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forge
WorkingDirectory=/opt/forge
ExecStart=/usr/bin/python3 -m help run
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening — the bot only needs to write help/logs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/forge/help/logs
RestrictAddressFamilies=AF_INET AF_INET6

# Settings (token, API keys) live in /opt/forge/help/helpbot/settings.py
# — edit that file directly; it is gitignored.

[Install]
WantedBy=multi-user.target
